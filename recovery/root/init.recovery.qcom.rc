import /init.recovery.qcom_decrypt.rc

on init
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop sys.usb.configfs 1

on fs
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    # TODO(ingres): haptic driver chown/chmod rules were dropped here - cupid's were for its
    # own aw8697 i2c addresses, unverified for ingres. Re-add once the real driver/i2c path
    # for ingres's haptic motor is known (check /sys/bus/i2c/drivers/ on a booted device).
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    install_keyring

on property:twrp.modules.loaded=true
    start touch_report
    start touchsensor
    # Mount firmware
    mkdir /firmware
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    # Load ADSP firmware for PMIC (battery/charger registers via PMIC glink, hosted on
    # the ADSP). /sys/kernel/boot_adsp/boot is a normal-boot-only vendor init.qti.write.sh
    # wrapper that doesn't exist in recovery's ramdisk; use the standard remoteproc sysfs
    # control instead. adsp.mdt + segments get found via the ueventd firmware fallback
    # search, which includes /firmware/image (the modem partition mounted just above).
    write /sys/class/remoteproc/remoteproc0/state start
    wait /sys/class/power_supply/battery
    start health-hal-2-1
    umount /firmware

# ---------------------------------------------------------------------------
# Service definitions that used to live as *local edits* outside this device
# tree (device/qcom/twrp-common and bootable/recovery/etc/init). A fresh
# OrangeFox sync doesn't carry those edits, which silently broke /data
# decryption and OTA installs again. Keep them here so the tree is
# self-contained.
# ---------------------------------------------------------------------------

# KeyMint (FBE metadata key unwrap). Upstream twrp-common (android-14) has no
# KeyMint support at all, so define it here. Uses the real vendor binary +
# APEX-only -V1-ndk_platform libs bundled in recovery/root/vendor/. `override`
# keeps this definition even if a (modified) twrp-common also defines one.
on property:hwservicemanager.ready=true && property:vendor.sys.listeners.registered=true
    start keymint-qti

service keymint-qti /vendor/bin/hw/android.hardware.security.keymint-service-qti
    override
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    seclabel u:r:recovery:s0

# bootctl HAL for update_engine_sideload / `twrp install` of OTA zips.
# bootable/recovery's own definition points at the AOSP-compiled
# /system/bin binary, which exits right away because hwservicemanager rejects
# its registration. Override it with the real vendor binary, which matches the
# VINTF fragment in vendor/etc/vintf/manifest/android.hardware.boot@1.2.xml.
service boot-hal-1-2 /vendor/bin/hw/android.hardware.boot@1.2-service
    override
    interface android.hardware.boot@1.0::IBootControl default
    interface android.hardware.boot@1.1::IBootControl default
    interface android.hardware.boot@1.2::IBootControl default
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    seclabel u:r:recovery:s0




# Haptics: tiny AIDL IVibrator (device/xiaomi/ingres/vibrator) driving the
# awinic_haptic sysfs node. Replaces Xiaomi's vibratorfeature HAL, which is
# built for vendor A12 libutils, SIGABRTs under fox_14.1's Android 14 runtime,
# crash-looped every 5s and stalled the UI on every vibration.
on boot
    start vibrator-hal-ingres

service vibrator-hal-ingres /system/bin/android.hardware.vibrator-service.ingres
    user root
    group root input
    disabled
    oneshot
    seclabel u:r:recovery:s0
